generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

enum Zone {
  A
  B
  C
}

enum Stage {
  GROUPS
  DESEMPATE
  SEMIFINAL_1
  SEMIFINAL_2
  FINAL
}

enum ResultStatus {
  PENDING
  WINNER_ONLY
  COMPLETE
}

enum SetFormat {
  SINGLE_21
  TWO_15_TIEBREAK
  BEST_OF_3_21
}

enum Phase {
  GROUPS
  DESEMPATE
  ELIMINATORIES
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model TournamentState {
  id            Int      @id @default(1)
  phase         Phase    @default(GROUPS)
  zoneConfirmed Boolean  @default(false)
  prepMinutes   Int      @default(5)
  matchMinutes  Int      @default(20)
  updatedAt     DateTime @updatedAt
}

model Team {
  id          String   @id @default(cuid())
  name        String
  zone        Zone
  matchesA    Match[]  @relation("TeamA")
  matchesB    Match[]  @relation("TeamB")
  wonMatches  Match[]  @relation("Winner")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Match {
  id           String       @id @default(cuid())
  stage        Stage        @default(GROUPS)
  zone         Zone?
  slot         Int
  timeLabel    String?
  teamAId      String?
  teamBId      String?
  teamA        Team?        @relation("TeamA", fields: [teamAId], references: [id])
  teamB        Team?        @relation("TeamB", fields: [teamBId], references: [id])
  /// Played sets as [{"teamA":21,"teamB":19}, ...]; null for WINNER_ONLY.
  sets         Json?
  setFormat    SetFormat?
  resultStatus ResultStatus @default(PENDING)
  winnerId     String?
  winner       Team?        @relation("Winner", fields: [winnerId], references: [id])
  recordedAt   DateTime?
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
}