generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

enum Zone {
  A
  B
  C
}

enum BracketFormat {
  STANDARD
  REPECHAJE
  CUARTOS
}

enum Stage {
  GROUPS
  DESEMPATE
  SEMIFINAL_1
  SEMIFINAL_2
  FINAL
  REPECHAJE_1
  REPECHAJE_2
  BRONZE
  CUARTOS_1
  CUARTOS_2
  CUARTOS_3
  CUARTOS_4
}

enum ResultStatus {
  PENDING
  WINNER_ONLY
  COMPLETE
}

enum SetFormat {
  SINGLE_21
  TWO_15_TIEBREAK
  TWO_21_TIEBREAK_15
  BEST_OF_3_21
}

/**
 * Circuit = annual season. (circuit, season) together identify one circuit:
 * Principiantes 2026 and Intermedios 2026 are different circuits, and
 * Intermedios 2027 is a new one that starts from zero.
 */
enum Circuit {
  PRINCIPIANTES
  INTERMEDIOS
}

enum Phase {
  GROUPS
  DESEMPATE
  ELIMINATORIES
}

/// Per-circuit configuration the organizer edits from the panel.
model CircuitSetting {
  id            String   @id @default(cuid())
  circuit       Circuit  @unique
  /// Drive folder the public gallery reads for this circuit. Null falls back to
  /// the deployment default (GALERIA_FOLDER_ID / the hardcoded folder).
  galleryFolder String?
  updatedAt     DateTime @updatedAt
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  username     String   @unique @default("")
  passwordHash String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model Etapa {
  id           String            @id @default(cuid())
  name         String
  date         DateTime?
  /// Circuit (annual season) this etapa belongs to. Existing rows stay
  /// Principiantes because that is the only circuit that ever ran here.
  circuit      Circuit           @default(PRINCIPIANTES)
  /// Season year inside the circuit; the annual table and the etapa numbering
  /// both restart every season.
  season       Int               @default(2026)
  /// Stage number INSIDE the circuit: Etapa 1 exists once per circuit.
  sortOrder    Int               @default(1)
  bracketFormat BracketFormat    @default(STANDARD)
  /// Set format chosen when the etapa is created. Null keeps the per-stage
  /// convention (groups 21, semis 2x15, final best-of-3) for old etapas.
  setFormat    SetFormat?
  teams        Team[]
  matches      Match[]
  state        TournamentState?
  zoneTies     ZoneTieResolution[]
  closedAt     DateTime?         /// inmutable: no results/zones edits after close
  cancelledAt  DateTime?         /// organizer can cancel (weather suspension) with password
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt

  @@unique([circuit, season, sortOrder])
}

model TournamentState {
  id            String   @id @default(cuid())
  etapaId       String   @unique
  etapa         Etapa    @relation(fields: [etapaId], references: [id], onDelete: Cascade)
  phase         Phase    @default(GROUPS)
  zoneConfirmed Boolean  @default(false)
  prepMinutes   Int      @default(5)
  matchMinutes  Int      @default(20)
  updatedAt     DateTime @updatedAt
}

model Team {
  id         String   @id @default(cuid())
  etapaId    String
  etapa      Etapa    @relation(fields: [etapaId], references: [id], onDelete: Cascade)
  name       String
  zone       Zone
  // Fixed mixed-pair teams (mixto fijo): exactly one male + one female player.
  // Nullable so loaded/seed etapas without players keep working; enforced at
  // team creation time and filled by the team loading UI (S4).
  maleName   String?
  femaleName String?
  matchesA   Match[]  @relation("TeamA")
  matchesB   Match[]  @relation("TeamB")
  wonMatches Match[]  @relation("Winner")
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([etapaId])
}

model Match {
  id           String       @id @default(cuid())
  etapaId      String
  etapa        Etapa        @relation(fields: [etapaId], references: [id], onDelete: Cascade)
  stage        Stage        @default(GROUPS)
  zone         Zone?
  slot         Int
  timeLabel    String?
  teamAId      String?
  teamBId      String?
  teamA        Team?        @relation("TeamA", fields: [teamAId], references: [id])
  teamB        Team?        @relation("TeamB", fields: [teamBId], references: [id])
  /// Played sets as [{"teamA":21,"teamB":19}, ...]; null for WINNER_ONLY.
  sets         Json?
  setFormat    SetFormat?
  resultStatus ResultStatus @default(PENDING)
  winnerId     String?
  winner       Team?        @relation("Winner", fields: [winnerId], references: [id])
  recordedAt   DateTime?
  manualStartAt DateTime?
  manualEndAt  DateTime?
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  @@index([etapaId])
}

/// Organizer decision for a zone tie that no merit metric can resolve.
/// One row per (etapa, zone): confirming again replaces the order.
model ZoneTieResolution {
  id        String   @id @default(cuid())
  etapaId   String
  etapa     Etapa    @relation(fields: [etapaId], references: [id], onDelete: Cascade)
  zone      Zone
  /// JSON array of team ids, best position first. Exactly the tied teams.
  order     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([etapaId, zone])
}
